rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /baba_accounts/{accountId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == accountId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if false;
    }
    match /baba/purchase-goals/{goalId}/image {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}
